# CampusPulse Backend Environment Configuration
APP_NAME="CampusPulse API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080/backend

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campuspulse
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT Authentication Secret & Expiry
JWT_SECRET=campuspulse_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=campuspulse-api

# Firebase Cloud Messaging (FCM) Configuration
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here
FCM_SENDER_ID=your_firebase_sender_id_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
