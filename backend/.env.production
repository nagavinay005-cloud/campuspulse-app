# =====================================================
# CampusPulse Backend - Production Environment Variables
# =====================================================
# Set these in your Railway/Render dashboard under Variables

# Application
APP_NAME="CampusPulse API"
APP_ENV=production
APP_DEBUG=false

# Database (Railway auto-provisions MYSQL* vars when you add a MySQL service)
# If using Railway MySQL plugin, these are auto-injected:
#   MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# Or set manually:
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=campuspulse
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_CHARSET=utf8mb4

# JWT Authentication (CHANGE THIS to a secure random string!)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_STRING
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=campuspulse-api

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FCM_SENDER_ID=your_firebase_sender_id
