rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION/ROLE RESOLVERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() ? getUserData().role : null;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == "Admin" || request.auth.token.admin == true);
    }

    function isOrganizer() {
      return isSignedIn() && (getUserRole() == "Organizer" || isAdmin());
    }

    function isStudent() {
      return isSignedIn() && getUserRole() == "Student";
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // EVENTS COLLECTION
    // =========================================================================

    match /events/{eventId} {
      allow read: if true; // Public feed discovery for students & visitors

      allow create: if isOrganizer() &&
        request.resource.data.organizerId == request.auth.uid &&
        request.resource.data.status in ['Draft', 'PendingApproval', 'Published'];

      allow update: if isAdmin() || (
        isOrganizer() &&
        resource.data.organizerId == request.auth.uid &&
        resource.data.status != 'Archived' &&
        resource.data.status != 'Deleted'
      );

      allow delete: if isAdmin() || (
        isOrganizer() &&
        resource.data.organizerId == request.auth.uid &&
        resource.data.status == 'Draft'
      );
    }

    // =========================================================================
    // REGISTRATIONS COLLECTION
    // =========================================================================

    match /registrations/{registrationId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isOrganizer() ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.registrationStatus in ['Pending', 'Approved', 'Waitlisted'];

      allow update: if isAdmin() || isOrganizer() || (
        isOwner(resource.data.studentId) &&
        request.resource.data.registrationStatus == 'Cancelled'
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // ATTENDANCE COLLECTION
    // =========================================================================

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isOrganizer() ||
        isAdmin()
      );

      allow create, update: if isOrganizer() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // CERTIFICATES COLLECTION
    // =========================================================================

    match /certificates/{certificateId} {
      allow read: if true; // Public certificate verification

      allow create, update: if isAdmin() || isOrganizer();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION
    // =========================================================================

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.role == getUserRole() ||
        resource.data.role == 'All' ||
        isAdmin()
      );

      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // =========================================================================
    // ANNOUNCEMENTS COLLECTION
    // =========================================================================

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isOrganizer() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // DEPARTMENTS & CLUBS COLLECTIONS
    // =========================================================================

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isOrganizer() || isAdmin();
    }

    // =========================================================================
    // FEEDBACK COLLECTION
    // =========================================================================

    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // ARCHIVE LOGS & TELEMETRY COLLECTION
    // =========================================================================

    match /archiveLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // ANALYTICS COLLECTION
    // =========================================================================

    match /analytics/{analyticsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // SETTINGS COLLECTION
    // =========================================================================

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
